# Copy this to .env.local and fill in your values

# Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Password to access the site (plain text — only you will ever see this)
ATS_PASSWORD=your-strong-password-here

# Random secret for signing JWT session tokens (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here
