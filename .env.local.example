# Copy to .env.local for local development

# Your deployed Cloudflare Worker URL (e.g. https://personal-ats.yourname.workers.dev)
NEXT_PUBLIC_WORKER_URL=https://personal-ats.yourname.workers.dev

# Base path if hosted at github.io/repo-name — e.g. /personal_ats
# Leave empty if using a custom domain at root
NEXT_PUBLIC_BASE_PATH=
